{
  "expo": {
    "name": "Ink Tag",
    "slug": "inktag",
    "scheme": "inktag",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.inktag.app"
    },
    "android": {
      "package": "dev.inktag.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Ink Tag uses your photos to choose a picture for your badge.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Ink Tag uses Bluetooth to send pictures to your badge."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "androidIntentFilters": [
            "image/*"
          ]
        }
      ],
      "./plugins/withGradleTuning"
    ],
    "extra": {
      "eas": {
        "projectId": "bdc8bc26-dc9c-4fc3-96ef-849a40aa4ec7"
      }
    },
    "owner": "iamrdev33"
  }
}
