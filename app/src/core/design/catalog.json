  {
   "id": "status-board",
   "title": "Status board",
   "behaviour": "board",
   "category": [
    "work"
   ],
   "tags": [
    "status",
    "door",
    "meeting",
    "busy",
    "desk"
   ],
   "description": "A set of ready statuses. Tap one and it goes straight to your badge.",
   "fills": "Your statuses, each with its ink",
   "board": {
    "from": "statuses"
   },
   "fields": [
    {
     "key": "statuses",
     "label": "Statuses (Label | ink)",
     "kind": "list",
     "max": 12
    },
    {
     "key": "note",
     "label": "Small print",
     "kind": "text",
     "placeholder": "Ext. 214"
    }
   ],
   "sample": {
    "statuses": "In a meeting | blue\nBack in 10 | yellow\nDo not disturb | red\nCome in | green\nLunch | black",
    "status": "In a meeting",
    "statusColor": "blue"
   },
   "layouts": [
    {
     "name": "Filled",
     "background": "{{statusColor}}",
     "blocks": [
      {
       "t": "text",
       "text": "{{status}}",
       "size": 0.15,
       "bold": true,
       "upper": true,
       "align": "center",
       "lines": 3
      },
      {
       "t": "text",
       "text": "{{note}}",
       "size": 0.04,
       "align": "center",
       "h": 0.1,
       "if": "note"
      }
     ]
    },
    {
     "name": "Outline",
     "frame": {
      "style": "line",
      "color": "{{statusColor}}"
     },
     "pad": 0.12,
     "blocks": [
      {
       "t": "text",
       "text": "{{status}}",
       "size": 0.14,
       "bold": true,
       "align": "center",
       "lines": 3
      },
      {
       "t": "rule",
       "color": "{{statusColor}}",
       "h": 0.02
      },
      {
       "t": "text",
       "text": "{{note}}",
       "size": 0.04,
       "align": "center",
       "h": 0.1,
       "if": "note"
      }
     ]
    }
   ]
  },
