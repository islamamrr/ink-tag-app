  {
   "id": "todo",
   "title": "To-do list",
   "behaviour": "list",
   "category": [
    "work",
    "everyday"
   ],
   "tags": [
    "tasks",
    "list",
    "desk",
    "tick"
   ],
   "description": "Tick items in the app and update the badge. Up to 10 items.",
   "fills": "A title and the items",
   "fields": [
    {
     "key": "title",
     "label": "Title",
     "kind": "text",
     "default": "Today"
    },
    {
     "key": "items",
     "label": "Items",
     "kind": "list",
     "max": 10
    },
    {
     "key": "done",
     "label": "Done items",
     "kind": "choice",
     "default": "strike",
     "options": [
      {
       "value": "strike",
       "label": "Cross out"
      },
      {
       "value": "hide",
       "label": "Hide"
      }
     ]
    },
    {
     "key": "accent",
     "label": "Accent ink",
     "kind": "choice",
     "default": "red",
     "options": [
      {
       "value": "red",
       "label": "Red"
      },
      {
       "value": "blue",
       "label": "Blue"
      },
      {
       "value": "green",
       "label": "Green"
      },
      {
       "value": "yellow",
       "label": "Yellow"
      },
      {
       "value": "black",
       "label": "Black"
      }
     ]
    }
   ],
   "sample": {
    "title": "Today",
    "items": "[x] Order booster parts\nReply to the factory\nTest firmware 0.4\nPhotos for the shop page"
   },
   "layouts": [
    {
     "name": "Plain",
     "blocks": [
      {
       "t": "text",
       "text": "{{title}}",
       "size": 0.08,
       "bold": true,
       "h": 0.11
      },
      {
       "t": "rule",
       "color": "{{accent}}",
       "h": 0.008
      },
      {
       "t": "list",
       "from": "items",
       "check": true,
       "done": "done",
       "accent": "{{accent}}",
       "size": 0.06
      }
     ]
    },
    {
     "name": "Band",
     "blocks": [
      {
       "t": "text",
       "text": "{{title}}",
       "size": 0.07,
       "bold": true,
       "upper": true,
       "band": "{{accent}}",
       "h": 0.13,
       "align": "center"
      },
      {
       "t": "list",
       "from": "items",
       "check": true,
       "done": "done",
       "accent": "{{accent}}",
       "size": 0.06
      }
     ]
    },
    {
     "name": "Big",
     "blocks": [
      {
       "t": "text",
       "text": "{{title}}",
       "size": 0.05,
       "bold": true,
       "h": 0.07,
       "color": "{{accent}}"
      },
      {
       "t": "list",
       "from": "items",
       "check": true,
       "done": "done",
       "accent": "{{accent}}",
       "size": 0.08
      }
     ]
    }
   ]
  },
